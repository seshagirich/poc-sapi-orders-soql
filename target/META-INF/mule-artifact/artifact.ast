s[0].productId[0],\n \"productName__c\": payload.orderHistory.items[0].productName[0],\n \"quantity__c\": payload.orderHistory.items[0].quantity[0] as String,\n \"price__c\": payload.orderHistory.items[0].price[0] as String\n\n\n}\n]\r\n]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003c/ee:transform\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"**order create table sql query print\" doc:id\u003d\"8c918558-66f0-4276-a140-c29ff64b7ef2\" message\u003d\"********order create table sql query print*****#[payload]*****\"\u003e\u003c/logger\u003e\r\n\u003csalesforce:create type\u003d\"orderCreate__c\" doc:name\u003d\"orderCreate Create\" doc:id\u003d\"daa75703-8568-46b4-bd71-1c5c808199e9\" config-ref\u003d\"Salesforce_Config\"\u003e\u003c/salesforce:create\u003e\r\n\u003cee:transform doc:name\u003d\"Transform Message\" doc:id\u003d\"b2363b70-8c9d-4351-9a3e-3b4170df5bec\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[\r\n%dw 2.0\noutput application/json\n---\npayload\r\n]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003c/ee:transform\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"*******end flow ******\" doc:id\u003d\"3962cb8f-e047-46be-a33b-36b0794be9ef\" message\u003d\"*******end flow ******#[payload]\"\u003e\u003c/logger\u003e\r\n\u003c/flow\u003e","startColumn":2,"startLine":12},"parameters":[{"unresolvedValue":"poc-sapi-orders-soqlFlow","metadata":{"docAttributes":{"id":"8f000623-e238-40f0-9958-28668866958a"},"endColumn":9,"endLine":58,"fileName":"poc-sapi-orders-soql.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":9},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":12},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":12},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":58},"CLOSING_TAG_START_COLUMN":{"type":"java.lan